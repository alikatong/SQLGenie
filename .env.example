APP_HOST=127.0.0.1
APP_PORT=8000
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_ENABLE_THINKING=true
LLM_REASONING_EFFORT=
LLM_THINKING_TIMEOUT_SECONDS=600
LLM_PROMPT_MAX_CHARS=60000
RAG_EMBEDDING_MODEL=models/Qwen3-Embedding-0.6B
RAG_EMBEDDING_BATCH_SIZE=4
RAG_EMBEDDING_MAX_SEQ_LENGTH=1024
RAG_CHROMA_PATH=.chroma
RAG_TOP_K=8
RAG_EXPAND_DEPTH=1
RAG_MIN_KEYWORD_HITS=2
RAG_MIN_KEYWORD_SCORE=6.0
RAG_MIN_VECTOR_SIMILARITY=0.65
RAG_MIN_VECTOR_MARGIN=0.08
HIS_TERM_TOP_K=8
RAG_COLLECTION_PREFIX=sqlgenie
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
SQLGENIE_DB_PATH=sqlgenie.db
# Comma-separated allowed browser origins. When left empty, SQLGenie falls
# back to the loopback dev origins (http://localhost:5173, http://127.0.0.1:5173).
# A wildcard "*" disables credentialed CORS (cookies/auth headers).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# In-process sliding-window rate limiting (set max to 0 to disable). Limits are
# per remote client IP for login and per authenticated user for SQL generation,
# and are stored in memory: each process keeps its own counters. Invalid inputs
# (unknown db, dialect mismatch) do not consume the generation budget.
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
GENERATE_RATE_LIMIT_MAX=30
GENERATE_RATE_LIMIT_WINDOW_SECONDS=60
